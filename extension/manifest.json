{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "MoodShift",
  "version": "0.1.0",
  "description": "Live audio effects for the Chrome tab you select.",
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "permissions": ["activeTab", "tabCapture", "offscreen", "sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://lrclib.net/*", "https://widget.songle.jp/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["youtube-playback.js"], "run_at": "document_start" }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "MoodShift · Select this tab", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" }
}
