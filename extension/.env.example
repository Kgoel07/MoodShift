# Copy to extension/.env.local for a production build. These values are public in the bundle.
# Use the HTTPS backend origin whose /health advertises the current command API.
API_BASE_URL=https://api.example.com

# Use ws://127.0.0.1:8788 for the local stem helper, or the AWS worker's WSS URL.
STEM_WS_URL=wss://stems.example.com/stem

# Optional. Production defaults to 4.5. Development defaults to 2.8.
# Set 2.8 for a production build that uses the local helper if it passes the throughput check.
# STEM_DELAY_SECONDS=4.5
