{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "MoodShift",
  "version": "0.1.0",
  "description": "Live audio effects for the Chrome tab you select.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://lrclib.net/*",
    "https://widget.songle.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-playback.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MoodShift · Select this tab",
    "default_icon": "assets/logo.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "assets/logo.png"
  }
}
