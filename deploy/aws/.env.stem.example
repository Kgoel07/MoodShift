# Use local for SSH forwarding. Use cloud for the public WSS demo.
STEM_DEPLOYMENT=local
# Set to the exact extension origin or comma-separated origins. Required in cloud mode.
ALLOWED_EXTENSION_ORIGINS=

# Cloud only. Use the same private demo code as the API for installations that use both services.
# DEMO_ACCESS_TOKEN=
# Optional session cap (30–3600 seconds). Defaults to 900 in cloud mode or 3600 locally.
# STEM_SESSION_SECONDS=900

# For Caddy, set STEM_DOMAIN in /etc/moodshift-caddy.env separately.
