# Required for text and voice commands. Keep this key on the backend.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.1-flash-lite. The alternate below supports text and voice on the free tier.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional locally. Required on Vercel. List exact installed extension origins, comma-separated.
# ALLOWED_EXTENSION_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Vercel only. Set these in the project's environment settings.
# MOODSHIFT_DEPLOYMENT=cloud-demo
# DEMO_ACCESS_TOKEN=
